# ─── Stripe (paiements CB + PayPal via Stripe) ───
# Clé secrète SERVEUR (jamais exposée au client, jamais commitée).
# Depuis Stripe Dashboard > Developers > API keys (mode TEST d'abord).
STRIPE_SECRET_KEY=votre_cle_secrete_stripe_ici

# Clé publiable CLIENT (préfixée NEXT_PUBLIC = visible côté navigateur, c'est normal).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=votre_cle_publique_stripe_ici

# Secret de signature du webhook (récupéré via Stripe CLI en local :
# `stripe listen --forward-to localhost:3002/api/webhooks/stripe`).
STRIPE_WEBHOOK_SECRET=votre_secret_webhook_stripe_ici

# Price ID Stripe par forfait (créés dans le dashboard Stripe test, ou via
# l'helper /api/checkout si tu préfères). Laisse vide pour création auto.
STRIPE_PRICE_INITIE=
STRIPE_PRICE_ORACLE=

# URL publique de l'app (pour les redirections success/cancel Stripe + reset password).
# SERVEUR UNIQUEMENT : ne pas préfixer par NEXT_PUBLIC_ (rien n'est exposé au client).
APP_URL=http://localhost:3002
