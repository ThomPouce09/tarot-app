# ===========================================
# CONFIGURATION DATABASE - Tarot Divinatoire
# ===========================================

# Option 1: PostgreSQL Local (recommandé pour le développement)
# Si tu as PostgreSQL installé localement
DATABASE_URL="postgresql://postgres:ton_mot_de_passe@localhost:5432/tarot_db?schema=public"

# Option 2: PostgreSQL Cloud (Neon, Railway, Supabase, etc.)
# Exemple avec Neon (gratuit):
# DATABASE_URL="postgresql://user:password@ep-xxx-xxx.us-east-2.aws.neon.tech/tarot_db?sslmode=require"

# Option 3: SQLite (alternative légère pour tester sans PostgreSQL)
# Pour utiliser SQLite, modifie prisma/schema.prisma:
#   provider = "sqlite"
#   url      = "file:./dev.db"
# Puis décommente cette ligne:
# DATABASE_URL="file:./dev.db"

# ===========================================
# VARIABLES OPTIONNELLES (pour fonctionnalités futures)
# ===========================================

# NextAuth (authentification)
# NEXTAUTH_URL="http://localhost:3000"
# NEXTAUTH_SECRET="ta_secret_key_generee_avec_openssl_rand_base64_32"

# API IA pour interprétation des tirages (à ajouter plus tard)
# OPENAI_API_KEY="sk-..."
# ANTHROPIC_API_KEY="sk-ant-..."

# AWS S3 (pour stockage des images si besoin)
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION="us-east-1"
# AWS_BUCKET_NAME=""

# ===========================================
# INSTRUCTIONS
# ===========================================
# 1. Copie ce fichier en .env
# 2. Configure DATABASE_URL selon ton setup
# 3. Lance: npx prisma generate
# 4. Lance: npx prisma db push
# 5. (Optionnel) Lance: npx prisma db seed
# 6. Lance: npm run dev