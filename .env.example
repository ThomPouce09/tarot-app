# =====================================
# Tarot App - Environment Variables
# =====================================

# NVIDIA API Key for AI Tarot Interpretation
# Get your API key from: https://build.nvidia.com/
# This key is used for the Stepfun/Step3-mini model
NVIDIA_API_KEY=nvapi-YOUR_KEY_HERE

# Database (Neon)
DATABASE_URL=postgresql://postgres:password@localhost:5432/tarot_db?schema=public

# SMTP Configuration for email confirmation
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@tarot.local

# App URL for confirmation links
NEXT_PUBLIC_APP_URL=http://localhost:3000