generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  password          String
  firstName         String?
  lastName          String?
  age               Int?
  phone             String?
  confirmationToken String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  confirmed         Boolean   @default(false)
  comment           String?
  gender            String?
  readings          Reading[]
  subscription      Subscription?
  usage             Usage?
  purchases         Purchase[]

  // ── Préférences (persistées pour le serveur : lettre hebdo + rappel push) ──
  emailNews         Boolean   @default(false)
  dailyReminder     Boolean   @default(false)
  dailyReminderHour Int       @default(18)   // 0-23, heure locale
  lastLetterSentAt  DateTime?
  // Fonds d'écran de la landing sélectionnés par l'utilisateur (chemins publics).
  // Vide = tous les fonds en mode aléatoire (défaut).
  backgrounds       String[]
  fcmToken          String?   // token Android/FCM pour la notification quotidienne
}

model Subscription {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId    String
  stripeSubscriptionId String
  stripePriceId       String
  plan                String // 'initie' | 'arkane'
  billing             String   @default("month") // 'month' | 'year'
  status              String // active | canceled | past_due | trialing
  currentPeriodEnd    DateTime
  cancelAtPeriodEnd   Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ─── Quotas & droits par compte ────────────────────────────────
// Compteurs journaliers/mensuels + packs one-shot (bienvenue, recharge)
// et bonus de connexion (streak 7 jours). 1:1 avec User.
model Usage {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Compteurs quotidiens (reset selon dateKey, format YYYY-MM-DD)
  dateKey         String   @default("")
  baseUsedToday   Int      @default(0)
  grandUsedToday  Int      @default(0)
  // Compteur mensuel (reset selon monthKey, format YYYY-MM)
  monthKey        String   @default("")
  grandUsedMonth  Int      @default(0)
  // Pack de bienvenue (one-shot, univers déjà servis)
  welcomeBaseUsed String[] @default([])
  welcomeGrandUsed Boolean @default(false)
  // Bonus de connexion (7 jours consécutifs) — compteur de grands offerts
  streakDays      Int      @default(0)
  lastStreakDate  String?
  bonusGrand      Int      @default(0) // grands cumulables gagnés via streak
  // Solde de la recharge cosmique (one-shot) : pool de crédits mixable.
  // 2€ = 105 crédits ; base = 7 crédits ; avancé = 15 crédits (15x7 = 105 = 7x15).
  rechargeCredits Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── Achats one-shot (bienvenue, recharge cosmique) ────────────
model Purchase {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind            String   // 'bienvenue' | 'recharge'
  amountEur       Float    @default(0)
  stripeSessionId String?
  createdAt       DateTime @default(now())
}

model Reading {
  id             String   @id @default(cuid())
  interpretation String?
  createdAt      DateTime @default(now())
  cards          String
  type           String
  userId         String
  question       String?
  spread         String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ─── Créatures / Lucioles (petits personnages errants) ─────
// Créées en base par SQL manuel (scripts/setup-creatures.ts) pour ne pas
// toucher aux tables existantes lors d'un 'prisma db push'.
model Creature {
  id         String   @id @default(cuid())
  slug       String   @unique // ex: luciole-aria, renard-rune...
  name       String   // nom affiché (FR)
  image      String   // /images/creatures/<slug>.png (~100px)
  page       String   // 'landing' | 'tarot' | 'runes' | 'yi-jing' (affinité)
  color      String?  // glow / accent (ex: '#FFD700')
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model CreatureMessage {
  id        String   @id @default(cuid())
  creatureId String
  category  String   // tips | credits | lore | advice | joke | history
  textFr    String
  textEn    String?
  createdAt DateTime @default(now())
}


// ─── Écrans d'attente personnalisés par type de tirage ─────
// Créée en base par SQL manuel (scripts/...) pour ne pas toucher la table
// 'hexagrams' existante lors d'un 'prisma db push'.
model MessagesAttente {
  id            String   @id @default(cuid())
  type          String   @unique // ex: tarot-3-cartes, yi-qing, yi-jing-du-jour...
  messages      String   // JSON: string[] textes d'attente défilants
  backgroundType String   @default("none") // image | video | none
  backgroundUrl  String?  // /public/wait/<type>.jpg ou .mp4
  animation     String   @default("fade") // clé d'anim framer-motion
  minDurationMs Int      @default(2500)
  updatedAt     DateTime @updatedAt
}

// ─── Interprétations des Dés du Zodiaque (Affinage) ─────────
// 144 combinaisons Planète × Signe × Maison pour le tirage par affinage.
model AstroInterpretation {
  id            String   @id @default(cuid())
  planet        String   // ex: Mercure
  sign          String   // Bélier, Taureau...
  house         String   // Maison 1 … Maison 12
  interpretation String  // Texte de l'interprétation générale

  @@unique([planet, sign, house])
  @@index([planet])
}

// ─── Templates de prompts personnalisables ───────────────────
// Stockés en base pour édition sans modifier le code.
// Chaque route API charge son prompt via la clé unique.
model PromptTemplate {
  id          String   @id @default(cuid())
  key         String   @unique  // ex: 'choix-short', 'choix-deep', 'dice-global', 'system'
  label       String            // ex: 'Analyse courte (Choix 1 & 2)', 'Analyse approfondie (Choix 1 & 2)'
  content     String            // Le texte du prompt avec placeholders {{variable}}
  description String?           // Notes internes
  version     Int      @default(1)
  updatedAt   DateTime @updatedAt
}

// ─── Messages de sagesse « pause repas » (1 par jour, bilingue) ─────────
// day = jour de l'année (1-365). textFr/textEn = message en français/anglais.
model DailyMessage {
  id     String @id @default(cuid())
  day    Int    @unique
  textFr String
  textEn String
}

// Pause repas : consommation du barman, une fois par jour et par compte (email).
// `date` = jour local du device (YYYY-MM-DD), ce qui aligne la fenêtre horaire
// "une fois/jour" sur le fuseau du visiteur.
model PauseRepasConsumption {
  id     String   @id @default(cuid())
  email  String
  date   String // YYYY-MM-DD (jour local du device)
  usedAt DateTime @default(now())
  @@unique([email, date])
}
