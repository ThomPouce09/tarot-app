generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  password          String
  firstName         String?
  lastName          String?
  age               Int?
  phone             String?
  confirmationToken String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  confirmed         Boolean   @default(false)
  comment           String?
  gender            String?
  readings          Reading[]
}

model Reading {
  id             String   @id @default(cuid())
  interpretation String?
  createdAt      DateTime @default(now())
  cards          String
  type           String
  userId         String
  question       String?
  spread         String?
  user           User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

// ─── Écrans d'attente personnalisés par type de tirage ─────
// Créée en base par SQL manuel (scripts/...) pour ne pas toucher la table
// 'hexagrams' existante lors d'un 'prisma db push'.
model MessagesAttente {
  id            String   @id @default(cuid())
  type          String   @unique // ex: tarot-3-cartes, yi-qing, yi-jing-du-jour...
  messages      String   // JSON: string[] textes d'attente défilants
  backgroundType String   @default("none") // image | video | none
  backgroundUrl  String?  // /public/wait/<type>.jpg ou .mp4
  animation     String   @default("fade") // clé d'anim framer-motion
  minDurationMs Int      @default(2500)
  updatedAt     DateTime @updatedAt
}
