<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ (API 31+) : le splash système n'utilise PAS le windowBackground
         plein écran (chemin legacy <12). Il compose : fond uni + icône masquée.
         Fond = la même nuit profonde que le voile in-app / legacy ; icône = logo
         centré avec marges transparentes (zone sûre du masque circulaire). -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:windowSplashScreenBackground">#0a0720</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
    </style>
</resources>
